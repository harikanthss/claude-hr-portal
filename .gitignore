# Dependencies
node_modules/
frontend/node_modules/
backend/node_modules/

# Build output (generated — not committed)
frontend/dist/
backend/public/

# Database files
backend/data/
backend/*.db
*.db

# Uploads (user content)
backend/uploads/*
!backend/uploads/.gitkeep

# Environment (never commit secrets)
.env
backend/.env
frontend/.env.local
frontend/.env.production.local

# Backups
backups/

# OS & editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Logs
*.log
npm-debug.log*
