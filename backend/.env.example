# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production

# ─── CORS (comma-separated allowed origins) ──────────────────────────────────
CORS_ORIGINS=https://your-domain.com,http://localhost:3001

# ─── Security (REQUIRED - generate with: node -e "require('crypto').randomBytes(64).toString('hex')") ──
JWT_SECRET=replace-with-64-char-random-string
JWT_EXPIRES_IN=8h

# ─── Database ─────────────────────────────────────────────────────────────────
# Leave empty to use SQLite (default, good for up to ~500 employees)
# Set to PostgreSQL URL for production with larger teams
# DATABASE_URL=postgresql://user:password@localhost:5432/grevya

# Supabase migration target (Priority 2)
# Keep SQLite untouched until cutover. Set these only when running Supabase-backed flows.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<database-password>@<host>:5432/postgres
# Supabase Auth tokens are verified through JWKS. Leave SUPABASE_JWT_SECRET empty unless using legacy JWT verification.
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_STORAGE_BUCKET=documents

# ─── AI Chat (optional - smart fallback used if not set) ─────────────────────
# Get from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ─── Email Notifications (optional) ──────────────────────────────────────────
# Leave empty to disable email (all actions still work, just no email alerts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
EMAIL_FROM="Grevya HR Portal <your-email@gmail.com>"

# ─── App URL (used in email links) ───────────────────────────────────────────
APP_URL=https://your-domain.com

# ─── File Uploads ─────────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=pdf,doc,docx,xls,xlsx,png,jpg,jpeg,zip,txt

# ─── Backups (optional - S3 sync) ────────────────────────────────────────────
# S3_BUCKET=your-s3-bucket-name
